# deploy/compose/.env.example — EVERY environment variable the openDox runtime
# reads, and the only place their names are written down outside
# `src/opendox/runtime/config.py`.
#
# `tests_runtime/test_deploy_shape.py` reads `config.SETTINGS` against this
# file and against `deploy/kubernetes/base/`, so a setting cannot exist in one
# of the three and not the others. That is the drift this file exists to stop:
# a variable added to a compose file and forgotten in the ConfigMap keeps
# working locally and fails only in the cluster.
#
# NO REAL CREDENTIAL IS EVER COMMITTED HERE OR ANYWHERE IN THIS REPOSITORY.
# The two DSNs below carry a password in a real install and the values in this
# file are PLACEHOLDERS for a throwaway local stack. Copy it to
# `deploy/compose/.env` (gitignored), fill it in, and never move a filled-in
# copy back.
#
#   cp deploy/compose/.env.example deploy/compose/.env
#   docker compose --env-file deploy/compose/.env \
#     -f deploy/compose/docker-compose.yaml --profile migration run --rm --build migrate
#   docker compose --env-file deploy/compose/.env \
#     -f deploy/compose/docker-compose.yaml up -d

# --- Postgres (the compose stack's own server) -----------------------------
# Used by the `postgres` service only. The application never reads these.
OPENDOX_PG_USER=opendox
OPENDOX_PG_PASSWORD=change-me-local-only
OPENDOX_PG_DB=opendox
# The least-privileged role the served application connects as is declared ONCE
# in this file, as `OPENDOX_RUNTIME_PG_ROLE` below — it is the runtime setting
# the migration narrows, and the compose file derives the role-creation
# variable and the migrate container's variable from that one name. This file
# used to declare `OPENDOX_RUNTIME_PG_USER` here as well, and the compose file
# read only that: an operator who set the documented `OPENDOX_RUNTIME_PG_ROLE`
# changed nothing, and one who set both differently created one role and
# narrowed another, leaving the real served role able to rewrite the migration
# ledger (Copilot review of openDox-code#25). Its PASSWORD stays here; a
# credential is not a name.
OPENDOX_RUNTIME_PG_PASSWORD=change-me-local-only-too

# --- the runtime's own settings (src/opendox/runtime/config.py) ------------

# REQUIRED. The RUNTIME DSN: the least-privileged identity the API serves with.
# It must not be the identity migrations run as — the separation is the point,
# and `opendox-runtime runtime migrate` refuses to borrow this one.
OPENDOX_DATABASE_URL=postgresql://opendox_runtime:change-me-local-only-too@postgres:5432/opendox

# The PRIVILEGED DSN ordered-SQL migrations are applied with. Read by
# `opendox-runtime runtime migrate` alone; the served application never receives it.
OPENDOX_MIGRATION_DATABASE_URL=postgresql://opendox:change-me-local-only@postgres:5432/opendox

# REQUIRED. The Keycloak broker's issuer, pinned (RULING Q2): a token from any
# other issuer is refused rather than trusted.
OPENDOX_OIDC_ISSUER=https://keycloak.example/realms/opendox

# REQUIRED. The audience this runtime accepts. A token minted for another
# client of the same broker is not a token for this one.
OPENDOX_OIDC_AUDIENCE=opendox-runtime

# The broker's JWKS URL. Leave EMPTY to derive it from the issuer
# (`<issuer>/protocol/openid-connect/certs`, which is what a Keycloak realm
# publishes); set it explicitly for a broker behind a rewriting proxy.
OPENDOX_OIDC_JWKS_URL=

# The accepted signature algorithms, comma-separated. ASYMMETRIC ONLY — the
# runtime refuses a symmetric entry at startup, because a runtime configured
# for HS256 would verify tokens signed with the public key anybody can fetch.
OPENDOX_OIDC_ALGORITHMS=RS256

# How long a fetched key set is reused before it is refetched, and the clock
# skew allowed on `exp`.
OPENDOX_OIDC_JWKS_TTL_SECONDS=300
OPENDOX_OIDC_LEEWAY_SECONDS=60

# Where the API listens. The container overrides the host to 0.0.0.0; a
# developer's default stays loopback.
OPENDOX_BIND_HOST=0.0.0.0
OPENDOX_BIND_PORT=8080

# THE ONE NAME. The least-privileged role the served application connects as —
# a name, never a credential. `deploy/compose/init-runtime-role.sh` CREATES
# this role (the compose file passes this value to the Postgres service),
# `OPENDOX_DATABASE_URL` above authenticates as it, and `opendox-runtime
# migrate` narrows its rights on the migration ledger to SELECT after applying,
# so a compromised API cannot rewrite the runner's own tamper-evident record.
# Creation, narrowing and the served DSN are one source: two names for this
# role is how they come apart.
OPENDOX_RUNTIME_PG_ROLE=opendox_runtime

# THE ROLE THE MIGRATION AUTHENTICATES AS — the user half of
# `OPENDOX_MIGRATION_DATABASE_URL`. Leave it EMPTY for the bundled shape, where
# the migration connects as `OPENDOX_PG_USER` and the first-start bootstrap
# already names that role. Set it when the migration DSN authenticates as
# somebody else: default privileges belong to the role that CREATES a table, so
# the bootstrap must aim them at the real migration owner or the served role
# gets no rights on the six tables at all — a Job that succeeds, a `/readyz`
# that says applied, and every request refused `permission denied` (Copilot
# review of openDox-code#25, round 12). `opendox-runtime runtime migrate` verifies the
# served role's access at the end of every run, so a mismatch fails the run.
OPENDOX_MIGRATION_PG_USER=

# The schema the bootstrap creates, grants usage on, grants the coordination
# tables in, and aims the migration owner's default privileges at. EMPTY or
# unset means `public`, which is the bundled shape. Set it to the SAME schema
# the two DSNs select with `options=-c search_path=<schema>`: the bootstrap
# cannot read a DSN (this is the database container's environment and a DSN
# carries a password), and a mismatch is caught by the migration run's own
# `verify_runtime_access` rather than by the first request (Copilot review of
# openDox-code#25, round 36, suppressed).
OPENDOX_PG_SCHEMA=

# Where the SERVED application reads, declared to the migration run so it can
# refuse to apply DDL anywhere else. A schema NAME and never a credential,
# which is why the migration container — which must not hold the served DSN —
# can be told it. The compose file derives it from `OPENDOX_PG_SCHEMA` above,
# so this is normally left empty and the two cannot drift; set it only where
# the migration workload is configured on its own (independent adversarial
# review of openDox-code#25, A25-3).
OPENDOX_SERVED_SCHEMA=

# And WHICH DATABASE the served application reads — the same declaration one
# level up, and the wider of the two. A migration DSN that names the wrong
# database applies DDL, and `runtime reset` DROPS the six coordination tables,
# somewhere the API never looks; and a DSN may omit `dbname` ENTIRELY, in which
# case libpq defaults it to the connection USER, so two DSNs that look alike
# can select two databases without either one saying so. A NAME and never a
# credential, which is why the migration container can be told it. The compose
# file derives it from `OPENDOX_PG_DB` above, so this is normally left empty
# and the two cannot drift (registered on openDox-code#26 from A25-3's half-
# closed finding, and built in the follow-up).
OPENDOX_SERVED_DATABASE=

# Whether to serve the interactive schema at /docs, /redoc and /openapi.json.
# OFF by default: FastAPI would otherwise publish the whole API surface to an
# unauthenticated caller, and this runtime's only public routes are its two
# probes. Turn it on for a development install, or behind a proxy that
# authenticates.
OPENDOX_PUBLISH_OPENAPI=false

# The ordered-SQL directory, repository-root-relative.
OPENDOX_MIGRATIONS_DIR=migrations

# Where the repository-creation act creates a project's plain local git
# repository (RULING C3), one directory per project id.
#
# ABSOLUTE, IN THIS PACKAGE. The compose file uses this same value as the
# container mount target of the `project_repositories` volume, and a mount
# target cannot be relative — the application's own default (`var/projects`,
# right for a developer running `opendox-runtime` directly) would give
# `docker compose up` an invalid mount. Measured on Docker Compose v5.5.1: the
# daemon refuses with "mount path must be absolute" at container creation.
OPENDOX_PROJECT_REPOSITORY_ROOT=/var/lib/opendox/projects

# --- image / build ---------------------------------------------------------
OPENDOX_IMAGE=opendox-runtime:local
OPENDOX_SOURCE_REVISION=unknown
